# Response headers for the Worker asset layer, matching what the Caddy
# container used to add so the security posture is unchanged after the move.
# Applied by Cloudflare without invoking a Worker, so requests stay unmetered.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; manifest-src 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Icons are fetched per entry and named after it, so they can be cached hard.
/icons/*
  Cache-Control: public, max-age=31536000, immutable
